msgid "(.+)\\.(.+) cannot be null"
msgstr "Поле \\1.\\2 не может быть пустым"

msgid "(.+)\\.(.+) exceeds (\\d+) UTF-8 bytes"
msgstr "Поле \\1.\\2 превышает допустимую длину: \\3 байт UTF-8"

msgid "(.+)\\.(.+) exceeds (\\d+) characters"
msgstr "Поле \\1.\\2 превышает допустимую длину: \\3 символов"

msgid "Ambiguous (.+) village (.+)"
msgstr "Населённый пункт \\2 неоднозначен в таблице \\1"

msgid "Ambiguous reference in (.+): (\\d+) matches; exactly one required"
msgstr "Неоднозначная ссылка в таблице \\1: совпадений \\2; требуется: 1"

msgid "Ambiguous village: multiple existing records"
msgstr "Населённый пункт неоднозначен: в базе несколько записей с таким названием"

msgid "Duplicate informant code in supplied CSV"
msgstr "Код информанта повторяется в загруженном CSV-файле"

msgid "Duplicate source code; identity is ambiguous"
msgstr "Код повторяется в исходном файле; невозможно однозначно определить человека"

msgid "Empty or duplicate column names"
msgstr "Пустые или повторяющиеся имена столбцов"

msgid "Existing person has different name/biography; refusing to overwrite or discard input"
msgstr "В базе уже есть человек с этим кодом, но с другими ФИО или биографией"

msgid "Expected region, district, village (three nonempty comma-separated parts)"
msgstr "Укажите область, район и населённый пункт через запятую; все три части обязательны"

msgid "Letter (.+) has no question number"
msgstr "У буквы \\1 нет номера вопроса"

msgid "Missing or nontransactional tables: (.+)"
msgstr "Отсутствуют таблицы или они не поддерживают транзакции: \\1"

msgid "Multiple collectors have the same name and code"
msgstr "В базе несколько собирателей с одинаковыми ФИО и кодом"

msgid "Multiple existing people have this code"
msgstr "В базе несколько человек с таким кодом"

msgid "No question references could be parsed"
msgstr "Не удалось распознать ни одного вопроса"

msgid "Question program is required"
msgstr "Программа обязательна"

msgid "Question reference has (\\d+) matches; exactly one required"
msgstr "Для вопроса найдено совпадений: \\1; требуется: 1"

msgid "Reference could not be inserted: (.+)"
msgstr "Не удалось добавить связанную запись: \\1"

msgid "Required column is missing"
msgstr "Обязательный столбец отсутствует"

msgid "Required value is empty"
msgstr "Обязательное значение не заполнено"

msgid "Supported databases: MySQL/InnoDB and SQLite"
msgstr "Поддерживаются базы данных MySQL/InnoDB и SQLite"

msgid "Text is required"
msgstr "Текст обязателен"

msgid "Unknown or ambiguous (informators|collectors) code: (\\d+) matches"
msgstr "Код информанта или собирателя не найден либо неоднозначен: совпадений \\2; требуется: 1"

msgid "Unknown reference in (.+): (\\d+) matches; exactly one required"
msgstr "Ссылка не найдена в таблице \\1: совпадений \\2; требуется: 1"

msgid "Unsupported question token (.+)"
msgstr "Недопустимое обозначение вопроса: \\1"

msgid "database"
msgstr "база данных"

msgid "file"
msgstr "файл"

msgid "header"
msgstr "заголовок"

msgid "row"
msgstr "строка"

msgid "transaction"
msgstr "транзакция"

